{
  "name": "social-network",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --recursive run build",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"apps/web/src/**/*.css\" --max-warnings=0",
    "check:utilities": "node scripts/check-no-utilities.mjs apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive run typecheck && tsc -p tsconfig.json",
    "test": "vitest run --project \"unit:*\"",
    "test:watch": "vitest --project \"unit:*\"",
    "test:integration": "vitest run --project \"integration:*\"",
    "test:e2e": "node scripts/run-e2e.mjs",
    "e2e:up": "node scripts/run-e2e.mjs --up",
    "e2e:down": "node scripts/run-e2e.mjs --down",
    "media:readme": "playwright test -c playwright.media.config.ts",
    "secrets:scan": "gitleaks git --redact --no-banner && gitleaks dir . --config .gitleaks.dir.toml --redact --no-banner",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm check:utilities && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:e2e && pnpm secrets:scan",
    "setup:env": "node scripts/setup-env.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "demo": "node scripts/dev-setup.mjs --demo",
    "infra:up": "docker compose up -d --wait postgres redis minio && docker compose run --rm minio-init",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile app up -d --build --wait",
    "stack:down": "docker compose --profile app down",
    "db:generate": "pnpm --filter @app/api run db:generate",
    "db:migrate": "pnpm --filter @app/api run db:migrate",
    "db:seed": "pnpm --filter @app/api run db:seed",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.3",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
