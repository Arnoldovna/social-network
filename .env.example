# Local development configuration (OVERVIEW §13). `pnpm setup:env` copies this file to .env (or adds missing keys to
# an existing .env) and fills the empty secrets SESSION_SECRET, CSRF_SECRET, S3_SECRET_ACCESS_KEY and
# SEED_DEMO_PASSWORD with random values. It never overwrites a value. Never commit .env.
# Every value here is a throwaway for the local Docker stack. SEED_ALLOW and E2E_BASE_URL are deliberately not here:
# they are set per invocation (db:seed, the compose seed service, scripts/run-e2e.mjs).

# --- API (apps/api/src/config/env.ts validates all of these) ---------------------------------------------------------
# development | test | production (pretty logs in development; the default of COOKIE_SECURE)
NODE_ENV=development
# API listen port (Vite proxies /api, /health and /socket.io to it in `pnpm dev`)
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Number of reverse proxies in front of the API (0..5): 0 for `pnpm dev`; compose sets 1 (nginx)
TRUST_PROXY=0
# Secure + __Host- cookies; defaults to true in production. Plain http locally, so false
COOKIE_SECURE=false
# Origins allowed for CORS and the Socket.IO handshake (comma-separated). Compose sets its own from WEB_PORT/E2E_PORT
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Postgres (compose service and the API's connection string) -----------------------------------------------------
# Compose creates the database from the three POSTGRES_* keys on the first start of its volume and builds the
# containers' URL from them, so use URL-safe characters only.
# Database user
POSTGRES_USER=social_network
# Fixed local value, not generated: DATABASE_URL below carries it literally (ADR-0019 §7)
POSTGRES_PASSWORD=local-only
# Database name
POSTGRES_DB=social_network
# Used by `pnpm dev`, `pnpm db:migrate` and `pnpm db:seed` on the host. Must name the same user, password and database
# as the three keys above; `pnpm dev:setup` stops with a message when they disagree
DATABASE_URL=postgres://social_network:local-only@127.0.0.1:5432/social_network

# --- Redis: sessions, rate limits, presence --------------------------------------------------------------------------
# Redis connection string (keys are prefixed with social-network:)
REDIS_URL=redis://127.0.0.1:6379

# --- Sessions and CSRF (secrets: generated by pnpm setup:env, at least 32 characters) -------------------------------
# Signs the session cookie
SESSION_SECRET=
# Rolling idle timeout of a session in days (1..90)
SESSION_TTL_DAYS=7
# Signs the CSRF double-submit token
CSRF_SECRET=

# --- Object storage (MinIO locally, S3 in production) ---------------------------------------------------------------
# S3 endpoint; unset for AWS S3
S3_ENDPOINT=http://127.0.0.1:9000
# S3 region (MinIO accepts any)
S3_REGION=eu-central-1
# Private bucket for avatars (created by the compose minio-init one-shot)
S3_BUCKET=avatars
# S3 access key; locally the MinIO root user
S3_ACCESS_KEY_ID=minio-local
# S3 secret key; locally also the MinIO root password (generated by pnpm setup:env)
S3_SECRET_ACCESS_KEY=
# MinIO needs path-style URLs
S3_FORCE_PATH_STYLE=true
# Largest accepted avatar upload in bytes: 1..2097152 (2 MiB, the client's limit too), so it can only lower the limit
UPLOAD_MAX_BYTES=2097152

# --- Real-time and rate limits ---------------------------------------------------------------------------------------
# Milliseconds a user stays online after the last socket closed (0..60000), so a reload does not flicker offline
PRESENCE_GRACE_MS=5000
# Multiplies every rate limit (1..10000): 1 locally and in production; the e2e stack uses 100
RATE_LIMIT_MULTIPLIER=1

# --- Seed (pnpm db:seed, the compose seed service) -------------------------------------------------------------------
# Password of the seeded demo account mira.novak@example.com (at least 12 characters, generated by pnpm setup:env)
SEED_DEMO_PASSWORD=

# --- Compose only ----------------------------------------------------------------------------------------------------
# Host port of `pnpm stack:up` / `pnpm demo` (http://127.0.0.1:8080); compose allow-lists this origin in CORS_ORIGINS
WEB_PORT=8080
# Host port of the isolated e2e project social-network-e2e (pnpm test:e2e, pnpm e2e:up)
E2E_PORT=8183
